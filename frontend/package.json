{
  "name": "kraftvakt-panel",
  "version": "0.10.6",
  "private": true,
  "description": "The Kraftvakt panel for the Home Assistant sidebar",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rollup --config",
    "watch": "rollup --config --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include=src"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@rollup/plugin-typescript": "12.3.1",
    "@vitest/coverage-v8": "5.1.0",
    "prettier": "3.10.1",
    "rollup": "4.68.4",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
